# Database Configuration - PostgreSQL AWS RDS
DB_HOST=your-rds-endpoint.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=pethome
DB_USERNAME=pethome_admin
DB_PASSWORD=your-database-password

# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-key-here-change-this-in-production
JWT_EXPIRATION=86400000

# Service Discovery - Eureka (Internal Docker Network)
EUREKA_SERVER_URL=http://eureka-server:8761/eureka
EUREKA_INSTANCE_HOSTNAME=eureka-server

# Config Server (Internal Docker Network)
CONFIG_SERVER_URL=http://config-server:8888

# API Gateway (Public EC2 IP or Domain)
GATEWAY_URL=http://your-ec2-public-ip:8080

# CORS Configuration (Add your frontend domains)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://your-frontend-domain.com,http://your-ec2-public-ip:8080

# Application Profile
SPRING_PROFILES_ACTIVE=docker

# AWS Region (optional, for future integrations)
AWS_REGION=us-east-1
